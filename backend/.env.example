# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/light_portfolio?schema=public
# Neon/Supabase: use the connection string they give you (usually needs ?sslmode=require)
DATABASE_URL=

# Random secret used to sign admin session tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# How long an admin login session stays valid before requiring a fresh
# login. Optional — defaults to "7d" if left blank.
JWT_EXPIRES_IN=7d

# Initial admin account — created by `npm run seed`. Change the password
# after first login is implemented (Phase 2); this is only the bootstrap value.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Port the API listens on
PORT=4000

# Exact origin of the frontend dev/prod server — used for CORS.
# Local dev default for this project's Vite setup:
FRONTEND_URL=http://localhost:5173

# development | test | production
NODE_ENV=development
