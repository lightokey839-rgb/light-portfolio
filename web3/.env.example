# Copy to .env and fill in locally. Never commit the real .env file —
# it's already covered by web3/.gitignore.

# RPC endpoint for Sepolia testnet (Alchemy, Infura, or any provider).
SEPOLIA_RPC_URL=

# Private key of the deployer wallet, funded with Sepolia test ETH from a
# faucet. NEVER use a wallet that holds real funds. NEVER commit this value.
DEPLOYER_PRIVATE_KEY=

# Etherscan API key, used only to verify deployed contract source code
# (POST to the Etherscan verification API — read-only in effect, but keep
# it secret like any other API key).
ETHERSCAN_API_KEY=

# Set to "true" to print a gas-usage report after `npm test`.
REPORT_GAS=false
